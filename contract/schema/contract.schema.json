{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fmd-web compatibility contract (DESIGN.md §5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "meta",
    "statusConstants",
    "events",
    "moduleSurface",
    "taskFields",
    "mangaInfoFields",
    "facades",
    "getInfoPipeline",
    "requireShims",
    "capabilities",
    "invariants"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designVersion", "source", "groundTruth", "schema"],
      "properties": {
        "designVersion": { "type": "string" },
        "source": { "type": "string" },
        "groundTruth": { "type": "string" },
        "schema": { "type": "string" }
      }
    },
    "statusConstants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["netStatus", "accountStatus"],
      "properties": {
        "netStatus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["no_error", "net_problem", "information_not_found"],
          "properties": {
            "no_error": { "const": 0 },
            "net_problem": { "const": 1 },
            "information_not_found": { "const": 2 }
          }
        },
        "accountStatus": {
          "type": "array",
          "items": { "type": "string", "enum": ["asUnknown", "asChecking", "asValid", "asInvalid"] },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "returns", "globals", "readBack"],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "GetDirectoryPageNumber", "GetNameAndLink", "GetInfo",
              "BeforeUpdateList", "AfterUpdateList", "TaskStart",
              "GetPageNumber", "GetImageURL", "BeforeDownloadImage",
              "DownloadImage", "SaveImage", "AfterImageSaved",
              "Login", "AccountState", "CheckSite"
            ]
          },
          "returns": { "type": "string", "enum": ["code", "boolean", "string"] },
          "globals": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Za-z]*$" }, "uniqueItems": true },
          "readBack": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "pushOnly": { "type": "boolean" },
          "constants": {
            "type": "string",
            "enum": ["net-status", "account-status", "none"],
            "description": "Which status-constant table the dispatcher binds: net-status (LuaPushNetStatus), account-status (LuaPushAccountStatus), or none."
          }
        }
      }
    },
    "moduleSurface": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "minItems": 1
    },
    "taskFields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "access", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "access": { "type": "string", "enum": ["read-write", "read-only"] },
          "kind": { "type": "string", "enum": ["list", "int", "string"] }
        }
      }
    },
    "mangaInfoFields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "minItems": 12
    },
    "facades": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "description": "§5.3–§5.7 object surfaces: TXQuery, IXQValue, TStrings, MangaInfo, Storage, HTTP, Crypto, ImagePuzzle, Duktape.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "fmd2Unit", "source", "access", "methods", "properties"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "fmd2Unit": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "access": {
            "type": "string",
            "enum": ["global-constructor", "event-global", "module-property", "require-lib", "derived-object"],
            "description": "How Lua reaches the facade: a global constructor function (CreateTXQuery, TStrings.New), an event-call global (HTTP, MANGAINFO), a property of MODULE (Storage), a require()-able lib (Crypto, ImagePuzzle, Duktape), or a value returned by another facade (IXQValue)."
          },
          "constructors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "notes": { "type": "string" }
              }
            },
            "uniqueItems": true
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "notes": { "type": "string" }
              }
            },
            "uniqueItems": true
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "access"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "access": { "type": "string", "enum": ["read-only", "read-write"] },
                "notes": { "type": "string" }
              }
            },
            "uniqueItems": true
          },
          "arrayProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "access"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "access": { "type": "string", "enum": ["read-only", "read-write"] },
                "notes": { "type": "string" }
              }
            },
            "uniqueItems": true
          },
          "defaultArrayProperty": {
            "type": "object",
            "additionalProperties": false,
            "required": ["access"],
            "properties": {
              "access": { "type": "string", "enum": ["read-only", "read-write"] },
              "notes": { "type": "string" }
            }
          },
          "headerSets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "headers"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "headers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
                "notes": { "type": "string" }
              }
            },
            "uniqueItems": true
          },
          "defaults": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "boolean"] },
            "description": "Fixed default values the shim must reproduce (e.g. RetryCount=0, MaxRedirect=5)."
          },
          "notes": { "type": "string" }
        }
      }
    },
    "getInfoPipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "dedup", "steps"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "dedup": {
          "type": "string",
          "const": "last-occurrence-wins",
          "description": "§5.8 step 4: on case-insensitive duplicate chapters the host deletes the EARLIER index, so the LAST occurrence's link+name survive."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "name", "description"],
            "properties": {
              "order": { "type": "integer", "minimum": 1 },
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    "requireShims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["require", "fmd2Unit", "implementation", "status"],
        "properties": {
          "require": { "type": "string", "minLength": 1 },
          "fmd2Unit": { "type": "string", "minLength": 1 },
          "implementation": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["planned", "partial", "stub"] }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "defaultEnabled"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "defaultEnabled": { "type": "boolean" }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  }
}
