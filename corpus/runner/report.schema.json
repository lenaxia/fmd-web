{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fmd-web.local/schemas/corpus-report-v1.json",
  "title": "Corpus replay report (DESIGN.md §13.1) — schema version 1",
  "type": "object",
  "required": ["schemaVersion", "engine", "normalization", "summary", "modules", "normalizations"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "engine": { "type": "string", "minLength": 1 },
    "normalization": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "required": ["cases", "passed", "failed", "passRate"],
      "additionalProperties": false,
      "properties": {
        "cases": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "modules", "passed", "failed", "cases"],
        "additionalProperties": false,
        "properties": {
          "module": { "type": "string", "minLength": 1 },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          "passed": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["fixtureId", "expression", "status", "expected", "actual"],
              "additionalProperties": false,
              "properties": {
                "fixtureId": { "type": "string", "minLength": 1 },
                "expression": {
                  "type": "object",
                  "required": ["id", "expression", "language", "output"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string" },
                    "expression": { "type": "string", "minLength": 1 },
                    "language": { "enum": ["xpath", "xquery", "css", "json"] },
                    "output": { "enum": ["scalar", "list", "count", "all"] }
                  }
                },
                "status": { "enum": ["pass", "fail", "error"] },
                "expected": {},
                "actual": {},
                "mismatch": {
                  "type": "object",
                  "required": ["field", "expected", "actual"],
                  "additionalProperties": false,
                  "properties": {
                    "field": { "enum": ["scalar", "list", "count", "error"] },
                    "expected": {},
                    "actual": {}
                  }
                }
              }
            }
          }
        }
      }
    },
    "normalizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fixtureId", "moduleId", "status", "expected", "actual"],
        "additionalProperties": false,
        "properties": {
          "fixtureId": { "type": "string", "minLength": 1 },
          "moduleId": { "type": "string" },
          "status": { "enum": ["pass", "fail", "error"] },
          "expected": {},
          "actual": {},
          "mismatch": {
            "type": "object",
            "required": ["expected", "actual"],
            "additionalProperties": false,
            "properties": {
              "expected": {},
              "actual": {}
            }
          }
        }
      }
    }
  }
}
