// fmd_capture.pas — ground-truth capture harness (D1).
//
// Evaluates expressions through the SAME engine FMD2 uses (InternetTools:
// xquery + xquery_json + simplehtmltreeparser), mirroring
// mangadownloader/XQueryEngineHTML.pas semantics exactly, and replicates
// the uData.pas:85-207 GetInfo normalization. NO LCL units are linked.
//
// Modes:
//   fmd_capture expression <fixture> <manifest.json> <out.json>
//       fixture: HTML/JSON file; manifest: {"fixtureId"?, "moduleId"?,
//       "document"?: "html"|"json", "expressions": [{"id"?, "expression",
//       "engine"?: "xpath"|"css", "output"?: "scalar"|"list"|"count"|"all"}]}
//       → JSON triples (fixtureId, expression, resultKind, result);
//       resultKind ∈ scalar|list|count|empty ("empty" = engine error
//       swallowed or genuinely empty sequence — exactly what FMD2 sees).
//   fmd_capture normalize <input.json> <out.json>
//       input: {"fixtureId"?, "moduleId"?, "rawModuleOutput": {...},
//       "flags"?: {...}} → normalized triples (uData.pas:85-207).
//   fmd_capture selftest
//       unit tests for the replicated helpers + normalization invariants.
//
// Build pins: internettools/FLRE commits + fpc version are recorded in
// corpus/meta.json and baked into the binary via -d defines (build.sh).
program fmd_capture;

{$mode objfpc}{$H+}
{$MACRO ON}
uses
  Classes, SysUtils, fpjson, jsonparser, fastjsonreader, xquery, xquery_json,
  simplehtmltreeparser, fmdstrings, fmdnormalize, fmdselftest;

// pins.inc is (re)generated by build.sh from corpus/meta.json so the
// recorded commit pins are baked into the binary; it carries 'unknown'
// defaults when compiled outside build.sh.
{$I pins.inc}

const
  FPCVersion = {$I %FPCVERSION%};
  CRLF = #13#10;

type

  { Replicates mangadownloader/XQueryEngineHTML.pas TXQueryEngineHTML —
    same units, same tree-parser config, same try/except→empty semantics. }

  { TXQueryEngineHTML }

  TXQueryEngineHTML = class
  private
    FEngine: TXQueryEngine;
    FTreeParser: TTreeParser;
    function Eval(const Expression: String; const isCSS: Boolean;
      const ContextItem: IXQValue; const Tree: TTreeNode): IXQValue;
  public
    constructor Create(const HTML: String = '');
    destructor Destroy; override;
    // evaluation entry points mirroring the original's public surface
    function XPath(const Expression: String; const ContextItem: IXQValue): IXQValue;
    function XPath(const Expression: String; const Tree: TTreeNode = nil): IXQValue;
    function CSS(const Expression: String; const ContextItem: IXQValue): IXQValue;
    function CSS(const Expression: String; const Tree: TTreeNode = nil): IXQValue;
    property Engine: TXQueryEngine read FEngine;
    property TreeParser: TTreeParser read FTreeParser;
  end;

function StreamToString(const Stream: TStream): String;
var
  p, x: Int64;
begin
  p := Stream.Position;
  Stream.Position := 0;
  SetLength(Result, Stream.Size);
  x := Stream.Read(PChar(Result)^, Stream.Size);
  SetLength(Result, x);
  Stream.Position := p;
end;

function ReadFileToString(const Path: String): String;
var
  FS: TFileStream;
begin
  FS := TFileStream.Create(Path, fmOpenRead or fmShareDenyWrite);
  try
    Result := StreamToString(FS);
  finally
    FS.Free;
  end;
end;

procedure WriteStringToFile(const Path, S: String);
var
  FS: TFileStream;
begin
  FS := TFileStream.Create(Path, fmCreate);
  try
    if S <> '' then
      FS.Write(PChar(S)^, Length(S));
  finally
    FS.Free;
  end;
end;

function GetJSONFromFile(const Path: String): TJSONData;
begin
  Result := GetJSON(ReadFileToString(Path));
end;

{ TXQueryEngineHTML }

// XQueryEngineHTML.pas:384-400 — identical tree-parser configuration
constructor TXQueryEngineHTML.Create(const HTML: String);
begin
  inherited Create;
  FEngine := TXQueryEngine.Create;
  FTreeParser := TTreeParser.Create;
  with FTreeParser do
  begin
    parsingModel := pmHTML;
    repairMissingStartTags := True;
    repairMissingEndTags := True;
    trimText := False;
    readComments := False;
    readProcessingInstructions := False;
    autoDetectHTMLEncoding := False;
    if HTML <> '' then
      parseTree(HTML);
  end;
end;

destructor TXQueryEngineHTML.Destroy;
begin
  FEngine.Free;
  FTreeParser.Free;
  inherited Destroy;
end;

// XQueryEngineHTML.pas:252-284 — the exact evaluation path: empty sequence
// on entry, swallowed exceptions → stays empty (error-swallow semantics)
function TXQueryEngineHTML.Eval(const Expression: String; const isCSS: Boolean;
  const ContextItem: IXQValue; const Tree: TTreeNode): IXQValue;
begin
  Result := xqvalue();
  try
    {$IFDEF CPU64} // For 64-bit mode, use Pointer to compare
    if Pointer(ContextItem) <> nil then
    {$ELSE} // For 32-bit mode, use a workaround or custom check
    if ContextItem.toBoolean then
    {$ENDIF}
    begin
      if isCSS then
        Result := FEngine.evaluateCSS3(Expression, ContextItem)
      else
        Result := FEngine.evaluateXPath(Expression, ContextItem);
    end
    else if Assigned(Tree) then
    begin
      if isCSS then
        Result := FEngine.evaluateCSS3(Expression, Tree)
      else
        Result := FEngine.evaluateXPath(Expression, Tree);
    end
    else
    begin
      if isCSS then
        Result := FEngine.evaluateCSS3(Expression, FTreeParser.getLastTree)
      else
        Result := FEngine.evaluateXPath(Expression, FTreeParser.getLastTree);
    end;
  except
  end;
end;

function TXQueryEngineHTML.XPath(const Expression: String;
  const ContextItem: IXQValue): IXQValue;
begin
  Result := Eval(Expression, False, ContextItem, nil);
end;

function TXQueryEngineHTML.XPath(const Expression: String;
  const Tree: TTreeNode): IXQValue;
begin
  Result := Eval(Expression, False, Default(IXQValue), Tree);
end;

function TXQueryEngineHTML.CSS(const Expression: String;
  const ContextItem: IXQValue): IXQValue;
begin
  Result := Eval(Expression, True, ContextItem, nil);
end;

function TXQueryEngineHTML.CSS(const Expression: String;
  const Tree: TTreeNode): IXQValue;
begin
  Result := Eval(Expression, True, Default(IXQValue), Tree);
end;

// ---------------------------------------------------------------------------
// expression mode
// ---------------------------------------------------------------------------

// XQueryEngineHTML.pas:130-137 AddSeparatorString (XPathStringAll join)
function AddSeparatorString(var Dest: String; const S: String;
  const Separator: String = ', '): String;
begin
  if Trim(S) <> '' then
    if Trim(Dest) = '' then
      Dest := Trim(S)
    else
      Dest := Trim(Dest) + Separator + Trim(S);
  Result := Dest;
end;

function EvalRequested(const ManifestEntry: TJSONObject; const AName,
  ADefault: String): String;
var
  D: TJSONData;
begin
  Result := ADefault;
  if ManifestEntry = nil then Exit;
  D := ManifestEntry.FindPath(AName);
  if D is TJSONString then
    Result := TJSONString(D).Value;
end;

procedure ModeExpression(const FixturePath, ManifestPath, OutPath: String);
var
  FixtureText, DocKind: String;
  ManifestData: TJSONData;
  Manifest, Entry: TJSONObject;
  ExprList: TJSONArray;
  I: Integer;
  Root, Triple: TJSONObject;
  ResultArr: TJSONArray;
  Item: IXQValue;
  Triples: TJSONArray;
  Q: TXQueryEngineHTML;
  JsonDoc: IXQValue;
  V: IXQValue;
  isCSS, IsJSONDoc: Boolean;
  EngineName, OutputKind, Expression, ExprId, FixtureId, ModuleId: String;
  Joined: String;
  IdD: TJSONData;

  function ResolveExpr(const Expr: String; const isCSSMode: Boolean;
    const Tree: TTreeNode): IXQValue;
  begin
    if isCSSMode then
      Result := Q.CSS(Expr, Tree)
    else
      Result := Q.XPath(Expr, Tree);
  end;

  function ResolveExprCtx(const Expr: String; const isCSSMode: Boolean;
    const Ctx: IXQValue): IXQValue;
  begin
    if isCSSMode then
      Result := Q.CSS(Expr, Ctx)
    else
      Result := Q.XPath(Expr, Ctx);
  end;

begin
  FixtureText := ReadFileToString(FixturePath);
  ManifestData := GetJSONFromFile(ManifestPath);
  Manifest := nil;
  ExprList := nil;
  if ManifestData is TJSONObject then
  begin
    Manifest := TJSONObject(ManifestData);
    if Manifest.FindPath('expressions') is TJSONArray then
      ExprList := TJSONArray(Manifest.FindPath('expressions'));
  end
  else if ManifestData is TJSONArray then
    ExprList := TJSONArray(ManifestData);
  if ExprList = nil then
    raise Exception.Create('manifest has no "expressions" array and is not an array itself');
  Triples := TJSONArray.Create;
  Q := nil;
  JsonDoc := Default(IXQValue);
  try
    IdD := ManifestData.FindPath('fixtureId');
    if IdD is TJSONString then
      FixtureId := TJSONString(IdD).Value
    else
      FixtureId := ExtractFileName(FixturePath);
    IdD := ManifestData.FindPath('moduleId');
    if IdD is TJSONString then
      ModuleId := TJSONString(IdD).Value
    else
      ModuleId := '';

    DocKind := LowerCase(EvalRequested(Manifest, 'document', ''));
    if DocKind = '' then
    begin
      if LowerCase(ExtractFileExt(FixturePath)) = '.json' then
        DocKind := 'json'
      else
        DocKind := 'html';
    end;
    IsJSONDoc := (DocKind = 'json-iq');
    if not ((DocKind = 'html') or (DocKind = 'json') or (DocKind = 'json-iq')) then
      raise Exception.CreateFmt('manifest document must be html|json|json-iq, got "%s"', [DocKind]);

    // All fixtures go through the SAME tree parser (XQueryEngineHTML
    // semantics; FMD2 modules feed JSON responses through it too and use
    // the `json(*)...` idiom, e.g. lua/modules/9hentai.lua:22). For
    // "json-iq" the raw JSON is additionally parsed into a ContextItem for
    // context-relative expressions (engine-default parser options,
    // xquery.pas:8410).
    Q := TXQueryEngineHTML.Create(FixtureText);
    if IsJSONDoc then
    begin
      JsonDoc := TXQJsonParser.parse(FixtureText,
        [jpoAllowMultipleTopLevelItems, jpoLiberal, jpoAllowTrailingComma, jpoJSONiq]);
    end;

    for I := 0 to ExprList.Count - 1 do
    begin
      if not (ExprList[I] is TJSONObject) then
        raise Exception.CreateFmt('expressions[%d] is not an object', [I]);
      Entry := TJSONObject(ExprList[I]);
      Expression := EvalRequested(Entry, 'expression', '');
      if Expression = '' then
        raise Exception.CreateFmt('expressions[%d].expression is empty', [I]);
      EngineName := LowerCase(EvalRequested(Entry, 'engine', 'xpath'));
      OutputKind := LowerCase(EvalRequested(Entry, 'output', 'scalar'));
      isCSS := (EngineName = 'css');
      IdD := Entry.FindPath('id');
      if IdD is TJSONString then
        ExprId := TJSONString(IdD).Value
      else
        ExprId := '';

      if IsJSONDoc then
        V := ResolveExprCtx(Expression, isCSS, JsonDoc)
      else
        V := ResolveExpr(Expression, isCSS, nil);

      Triple := TJSONObject.Create;
      Triple.Add('fixtureId', FixtureId);
      if ExprId <> '' then
        Triple.Add('id', ExprId);
      Triple.Add('expression', Expression);
      Triple.Add('engine', EngineName);
      Triple.Add('output', OutputKind);

      // XPathString / XPathStringAll / XPathCount mirrors
      if OutputKind = 'count' then
      begin
        Triple.Add('resultKind', 'count');
        Triple.Add('result', V.Count);
      end
      else if OutputKind = 'list' then
      begin
        // EvalStringAll(TheStrings) shape: Trim(v.toString) per item
        ResultArr := TJSONArray.Create;
        for Item in V do
          ResultArr.Add(Trim(Item.toString));
        if V.Count = 0 then
          Triple.Add('resultKind', 'empty')
        else
          Triple.Add('resultKind', 'list');
        Triple.Add('result', ResultArr);
      end
      else if OutputKind = 'all' then
      begin
        // XPathStringAll: ', '-join of trimmed non-empty values
        Joined := '';
        for Item in V do
          AddSeparatorString(Joined, Item.toString);
        if Joined = '' then
        begin
          Triple.Add('resultKind', 'empty');
          Triple.Add('result', '');
        end
        else
        begin
          Triple.Add('resultKind', 'scalar');
          Triple.Add('result', Joined);
        end;
      end
      else // scalar (XPathString: Eval(...).toString)
      begin
        if V.Count = 0 then
        begin
          Triple.Add('resultKind', 'empty');
          Triple.Add('result', '');
        end
        else
        begin
          Triple.Add('resultKind', 'scalar');
          Triple.Add('result', V.toString);
        end;
      end;
      Triples.Add(Triple);
    end;

    Root := TJSONObject.Create;
    try
      Root.Add('generator', 'fmd_capture');
      Root.Add('mode', 'expression');
      Root.Add('fixture', FixturePath);
      Root.Add('document', DocKind);
      if ModuleId <> '' then
        Root.Add('moduleId', ModuleId);
      Root.Add('internettoolsCommit', InternetToolsCommit);
      Root.Add('flreCommit', FLRECommit);
      Root.Add('fpcVersion', FPCVersion);
      Root.Add('triples', Triples);
      Triples := nil; // owned by Root now
      WriteStringToFile(OutPath, Root.FormatJSON([], 2) + CRLF);
    finally
      Root.Free;
    end;
  finally
    Q.Free;
    ManifestData.Free;
    Triples.Free;
  end;
end;

// ---------------------------------------------------------------------------
// normalize mode
// ---------------------------------------------------------------------------

procedure ModeNormalize(const InputPath, OutPath: String);
var
  Input, Raw, FlagsObj, Root: TJSONObject;
  FixtureId, ModuleId: String;
  Flags: TNormalizeFlags;
  IdD: TJSONData;
  NormOut: TJSONObject;
  Triples: TJSONArray;
  Triple: TJSONObject;
begin
  Input := TJSONObject(GetJSONFromFile(InputPath));
  // fpjson trees take ownership on Add(); every hand-off nils the local var
  // so the finally-block frees exactly once, exception or not.
  Root := nil;
  Triples := nil;
  Triple := nil;
  NormOut := nil;
  FlagsObj := nil;
  try
    IdD := Input.FindPath('fixtureId');
    if IdD is TJSONString then
      FixtureId := TJSONString(IdD).Value
    else
      FixtureId := ExtractFileName(InputPath);
    IdD := Input.FindPath('moduleId');
    if IdD is TJSONString then
      ModuleId := TJSONString(IdD).Value
    else
      ModuleId := '';

    if Input.FindPath('rawModuleOutput') is TJSONObject then
      Raw := TJSONObject(Input.FindPath('rawModuleOutput'))
    else
      raise Exception.Create('input has no "rawModuleOutput" object');

    Flags := FlagsFromJSON(Input.FindPath('flags'));
    FlagsObj := TJSONObject.Create;
    FlagsObj.Add('removeHostFromChapterLinks', Flags.isRemoveHostFromChapterLinks);
    FlagsObj.Add('optionRemoveMangaNameFromChapter', Flags.OptionRemoveMangaNameFromChapter);

    NormOut := TJSONObject.Create;
    NormalizeMangaInfo(Raw, Flags, NormOut);

    Triple := TJSONObject.Create;
    Triple.Add('fixtureId', FixtureId);
    Triple.Add('input', Raw.Clone);
    Triple.Add('normalized', NormOut);
    NormOut := nil; // ownership → Triple
    Triples := TJSONArray.Create;
    Triples.Add(Triple);
    Triple := nil;  // ownership → Triples

    Root := TJSONObject.Create;
    Root.Add('generator', 'fmd_capture');
    Root.Add('mode', 'normalize');
    Root.Add('fixture', InputPath);
    if ModuleId <> '' then
      Root.Add('moduleId', ModuleId);
    Root.Add('internettoolsCommit', InternetToolsCommit);
    Root.Add('flreCommit', FLRECommit);
    Root.Add('fpcVersion', FPCVersion);
    Root.Add('flags', FlagsObj);
    FlagsObj := nil; // ownership → Root
    Root.Add('triples', Triples);
    Triples := nil;  // ownership → Root
    WriteStringToFile(OutPath, Root.FormatJSON([], 2) + CRLF);
  finally
    Root.Free;
    Triples.Free;
    Triple.Free;
    NormOut.Free;
    FlagsObj.Free;
    Input.Free;
  end;
end;

// ---------------------------------------------------------------------------

procedure Usage;
begin
  WriteLn('fmd_capture — FMD2 ground-truth capture harness');
  WriteLn('usage:');
  WriteLn('  fmd_capture expression <fixture> <manifest.json> <out.json>');
  WriteLn('  fmd_capture normalize <input.json> <out.json>');
  WriteLn('  fmd_capture selftest');
  Halt(1);
end;

begin
  // All fixture/manifest data is UTF-8; make implicit AnsiString conversions
  // UTF-8 so fpjson round-trips raw UTF-8 without lossy '?' replacement.
  SetMultiByteConversionCodePage(CP_UTF8);
  try
    if ParamCount() < 1 then
      Usage;
    if ParamStr(1) = 'expression' then
    begin
      if ParamCount() <> 4 then Usage;
      ModeExpression(ParamStr(2), ParamStr(3), ParamStr(4));
    end
    else if ParamStr(1) = 'normalize' then
    begin
      if ParamCount() <> 3 then Usage;
      ModeNormalize(ParamStr(2), ParamStr(3));
    end
    else if ParamStr(1) = 'selftest' then
    begin
      Halt(Ord(RunSelfTests > 0));
    end
    else
      Usage;
  except
    on E: Exception do
    begin
      WriteLn(ErrOutput, 'fmd_capture: ' + E.ClassName + ': ' + E.Message);
      Halt(2);
    end
  end;
end.
