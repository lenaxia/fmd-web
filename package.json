{
  "name": "fmd-web",
  "version": "0.1.0",
  "private": true,
  "description": "Dockerized web rebuild of FMD2 that runs FMD2's Lua site-module ecosystem and FMD2-DB catalogs unchanged (DESIGN.md v5).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "workspaces": [
    "contract",
    "server",
    "corpus",
    "web"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json",
    "contract:check": "npm run contract:check -w @fmd/contract",
    "ci": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.17.1",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^3.2.4",
    "yaml": "^2.6.1"
  }
}
